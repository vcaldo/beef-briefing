# Production Environment Variables
# Copy to .env.prod and fill in values
# Used with: docker-compose -f docker-compose.prod.yml --env-file .env.prod up

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# In production, use Docker service name 'postgres' for container networking
DB_HOST=postgres
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=beef_briefing
DB_PORT=5432
DB_SSL_MODE=disable

# =============================================================================
# API SERVICE CONFIGURATION
# =============================================================================
API_PORT=8080
MAX_UPLOAD_SIZE_MB=100
API_SERVICE_URL=http://api-service:8080

# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================
TELEGRAM_BOT_TOKEN=your_production_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_without_at_sign

# =============================================================================
# LINODE OBJECT STORAGE CONFIGURATION
# =============================================================================
# Bucket suffix for Terraform (final name: {domain}-{suffix})
# Used by 'make tf-setup' to populate terraform.tfvars
OBJECT_STORAGE_BUCKET_SUFFIX=beef-briefing-media
# Credentials from Terraform output (linode_object_storage_key)
# The app uses MINIO_* env vars for S3-compatible storage
MINIO_ENDPOINT=es-mad-1.linodeobjects.com
MINIO_ACCESS_KEY=your_linode_access_key
MINIO_SECRET_KEY=your_linode_secret_key
MINIO_BUCKET=beef-briefing-media
MINIO_USE_SSL=true

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=production
LOG_LEVEL=info

# =============================================================================
# ANALYTICS API CONFIGURATION
# =============================================================================
# API key for analytics endpoints (external dashboard access)
# For production, load from secrets file
# Generate with: make generate-analytics-api-key
ANALYTICS_API_KEY_FILE=/app/secrets-api/analytics_api_key

# =============================================================================
# ADMIN PANEL SECRETS
# =============================================================================
# Admin panel port (internal, not exposed externally when using Traefik)
ADMIN_PANEL_PORT=8081
ADMIN_USERNAME=admin
ADMIN_PANEL_DOMAIN_SUFFIX=admin

# Generate secrets with: make admin-panel-set-secrets-files
ADMIN_PASSWORD_HASH_FILE=/app/secrets/admin_password_hash
SESSION_SECRET_FILE=/app/secrets/session_secret

# =============================================================================
# DASHBOARD CONFIGURATION
# =============================================================================
# Port for the analytics dashboard (internal, exposed via Traefik)
DASHBOARD_PORT=8050
# Comma-separated list of allowed Telegram chat IDs
ADMIN_USER_IDS=1234567890,0987654321
# Session lifetime in days
SESSION_LIFETIME_DAYS=7

# =============================================================================
# TRAEFIK REVERSE PROXY & SSL CONFIGURATION
# =============================================================================
# Domain name for SSL certificates and routing
# Note: DOMAIN_NAME is also used by Terraform (see LINODE/TERRAFORM section below)
# Make sure both references use the same domain value
DOMAIN_NAME=mydomain.example

# Let's Encrypt email for certificate notifications and renewal alerts
# IMPORTANT: This email will receive certificate expiry warnings
LETSENCRYPT_EMAIL=admin@mydomain.example

# Traefik dashboard basic auth credentials (htpasswd format with bcrypt)
# Generate with: make generate-traefik-password ENV_FILE=infrastructure/.env.prod
# Format: username:$$2y$$05$$hashedpassword
# Note: $$ escapes the $ character for docker-compose (required)
# Example output: admin:$$2y$$05$$gHL5l9SFHfFGrJm4gVQ65OrLFsMfSrZK7GwDPFJRE5gJQTDRvdlT2
TRAEFIK_DASHBOARD_USERS=admin:$$2y$$05$$...your_bcrypt_hash_here...

# =============================================================================
# DOCKER IMAGE TAG
# =============================================================================
# Set by CI/CD or Makefile during deployment (git commit hash)
IMAGE_TAG=latest

# =============================================================================
# LINODE BLOCK STORAGE
# =============================================================================
# Mount path for PostgreSQL data (must match terraform postgres_volume_mount_path)
# This is where the Linode block storage volume is mounted on the server
POSTGRES_DATA_PATH=/mnt/postgres-data

# =============================================================================
# LINODE / TERRAFORM CONFIGURATION
# =============================================================================
# These are used by Terraform, not by the application directly

# Linode API token for Terraform
LINODE_TOKEN=your_linode_api_token_here

# Linode region for deployment (default: eu-central)
# Available regions: eu-central, es-mad, us-east, us-central, us-southeast, etc.
LINODE_REGION=eu-central

# Linode instance type (default: g6-standard-1)
# Available types: g6-nanode-1, g6-standard-1, g6-standard-2, g6-standard-4, etc.
LINODE_INSTANCE_TYPE=g6-standard-1

# Hostname for the Linode instance (default: beef-briefing)
LINODE_HOSTNAME=beef-briefing

# Domain Configuration (defined above in TRAEFIK section)
# DOMAIN_NAME=mydomain.example

# SSH Public Key for server access
SSH_PUBLIC_KEY_PATH=~/.ssh/id_rsa.pub

# Linode Block Storage size in GB (default: 10)
POSTGRES_VOLUME_SIZE=10

# Mount path for PostgreSQL data (must match terraform postgres_volume_mount_path)
POSTGRES_DATA_PATH=/mnt/postgres-data

# Linode Object Storage region (default: es-mad)
OBJECT_STORAGE_REGION=es-mad

# Enable versioning for Object Storage bucket (default: true)
OBJECT_STORAGE_VERSIONING=true

# Object Storage lifecycle: days until objects expire (default: 365)
OBJECT_STORAGE_LIFECYCLE_DAYS=365

# Object Storage lifecycle: days until old versions expire (default: 5)
OBJECT_STORAGE_VERSION_RETENTION_DAYS=5

# =============================================================================
# NEW RELIC MONITORING (OPTIONAL)
# =============================================================================
# Infrastructure monitoring (used by Terraform)
NEW_RELIC_API_KEY=your_new_relic_api_key_here
NEW_RELIC_ACCOUNT_ID=your_new_relic_account_id_here
NEW_RELIC_REGION=EU

# APM instrumentation (leave blank to disable)
# App name format: {base-name}-{service}-{environment}
# e.g., NEW_RELIC_APP_NAME=beef-briefing with api-service becomes:
#   "beef-briefing-api-service-production"
NEW_RELIC_APP_NAME=beef-briefing
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key_here

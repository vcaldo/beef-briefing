# Development Environment Variables
# Copy to .env.dev and fill in values
# Used with: docker-compose -f docker-compose.dev.yml --env-file .env.dev up

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# In development, use Docker service name 'postgres' for container networking
DB_HOST=postgres
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=beef_briefing
DB_PORT=5432
DB_SSL_MODE=disable

# =============================================================================
# API SERVICE CONFIGURATION
# =============================================================================
API_PORT=8080
MAX_UPLOAD_SIZE_MB=100
API_SERVICE_URL=http://api-service:8080

# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_without_at_sign

# =============================================================================
# MINIO CONFIGURATION (Local Development)
# =============================================================================
# In development, use local MinIO container
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=telegram-media
MINIO_USE_SSL=false

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=debug

# =============================================================================
# ANALYTICS API CONFIGURATION
# =============================================================================
# API key for analytics endpoints (external dashboard access)
# For development, use a simple test key
ANALYTICS_API_KEY=dev-test-key-12345

# =============================================================================
# ADMIN PANEL SECRETS
# =============================================================================
# Generate secrets with: make admin-panel-set-secrets-files
ADMIN_PASSWORD_HASH_FILE=/app/secrets/admin_password_hash
SESSION_SECRET_FILE=/app/secrets/session_secret

# =============================================================================
# DASHBOARD CONFIGURATION
# =============================================================================
# Port for the analytics dashboard
DASHBOARD_PORT=8050
# Comma-separated list of allowed Telegram chat IDs
ADMIN_USER_IDS=1234567890,0987654321
# Session lifetime in days
SESSION_LIFETIME_DAYS=7

# =============================================================================
# NEW RELIC APM CONFIGURATION (OPTIONAL)
# =============================================================================
# Application Performance Monitoring - leave blank to disable
# App name format: {base-name}-{service}-{environment}
# e.g., NEW_RELIC_APP_NAME=beef-briefing with api-service becomes:
#   "beef-briefing-api-service-development"
# NEW_RELIC_APP_NAME=beef-briefing
# NEW_RELIC_LICENSE_KEY=your_new_relic_license_key_here

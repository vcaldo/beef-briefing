package templates

templ Layout(theme string, title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en" data-theme={ theme }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } | Beef Briefing Admin</title>
			<!-- Preconnect for fonts -->
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<!-- Google Fonts -->
			<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@700;800&family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet"/>
			<!-- Tailwind CSS + DaisyUI -->
			<link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.14/dist/full.min.css" rel="stylesheet" type="text/css"/>
			<script src="https://cdn.tailwindcss.com"></script>
			<!-- HTMX -->
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<!-- ECharts -->
			<script src="https://cdn.jsdelivr.net/npm/echarts@5.5.1/dist/echarts.min.js"></script>
			<!-- Custom CSS -->
			<link href="/static/css/admin.css" rel="stylesheet" type="text/css"/>
		</head>
		<body class="min-h-screen bg-gradient">
			<div class="navbar-container">
				<nav class="navbar">
					<div class="flex-1">
						<a href="/" class="navbar-logo">
							<span class="text-2xl">🥩</span>
							<span class="navbar-title">Beef Briefing</span>
						</a>
					</div>
					<div class="flex-none gap-2">
						<!-- Theme Dropdown -->
						<div class="dropdown dropdown-end">
							<div tabindex="0" role="button" class="btn btn-ghost btn-circle">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M4.098 19.902a3.75 3.75 0 005.304 0l6.401-6.402M6.75 21A3.75 3.75 0 013 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 003.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072M10.5 8.197l2.88-2.88c.438-.439 1.15-.439 1.59 0l3.712 3.713c.44.44.44 1.152 0 1.59l-2.879 2.88M6.75 17.25h.008v.008H6.75v-.008z"/>
								</svg>
							</div>
							<ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow-lg bg-base-200 rounded-box w-52 mt-4">
								<li class="menu-title">Theme</li>
								@themeOption("light", "☀️ Light", theme)
								@themeOption("dark", "🌙 Dark", theme)
								@themeOption("business", "💼 Business", theme)
								@themeOption("cyberpunk", "🤖 Cyberpunk", theme)
								@themeOption("forest", "🌲 Forest", theme)
							</ul>
						</div>
						<!-- Logout Button -->
						<form action="/auth/logout" method="POST">
							<button type="submit" class="btn btn-ghost btn-circle">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"/>
								</svg>
							</button>
						</form>
					</div>
				</nav>
			</div>
			<main class="container mx-auto px-4 py-8">
				@content
			</main>
			<!-- Custom JS -->
			<script src="/static/js/charts.js"></script>
		</body>
	</html>
}

templ themeOption(value string, label string, currentTheme string) {
	<li>
		<button
			hx-post="/theme"
			hx-vals={ templ.JSONString(map[string]string{"theme": value}) }
			hx-swap="none"
			hx-on--after-request={ "document.documentElement.setAttribute('data-theme', '" + value + "')" }
			class={ templ.KV("active", currentTheme == value), "flex items-center gap-2" }
		>
			{ label }
		</button>
	</li>
}

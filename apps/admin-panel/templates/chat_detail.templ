package templates

import (
	"fmt"
	"time"
)

// ChatDetail holds details for a single chat view
type ChatDetail struct {
	ID           int64
	Title        string
	Type         string
	Username     string
	FirstName    string
	LastName     string
	MessageCount int
	UserCount    int
	MediaCount   int
	FirstMessage time.Time
	LastMessage  time.Time
}

// Overview holds chat overview statistics
type Overview struct {
	TotalMessages    int
	UniqueUsers      int
	TotalReactions   int
	TotalMedia       int
	MessagesPerDay   float64
	MostActiveUser   *UserSummary
	TopEmojis        []EmojiBreakdown
	MediaBreakdown   map[string]int
}

// UserSummary is a brief user info
type UserSummary struct {
	UserID       int64
	Username     string
	FirstName    string
	LastName     string
	MessageCount int
}

// EmojiBreakdown holds emoji usage stats
type EmojiBreakdown struct {
	Emoji string
	Count int
}

// LeaderboardEntry holds per-user ranking
type LeaderboardEntry struct {
	Rank              int
	UserID            int64
	Username          string
	FirstName         string
	LastName          string
	Score             int
	MessageCount      int
	ReactionsGiven    int
	ReactionsReceived int
	MediaSent         int
}

// HeatmapDay holds message count for a single day
type HeatmapDay struct {
	Date  string
	Count int
}

// TimelinePoint holds activity for a time period
type TimelinePoint struct {
	Period        string
	MessageCount  int
	UserCount     int
	ReactionCount int
}

// TopMessage holds a popular message
type TopMessage struct {
	MessageID    int64
	UserID       int64
	Username     string
	FirstName    string
	LastName     string
	Text         string
	Score        int
	TopReactions []EmojiBreakdown
	SentAt       time.Time
}

// UserDetail holds detailed user statistics
type UserDetail struct {
	UserID            int64
	Username          string
	FirstName         string
	LastName          string
	Stats             UserDetailStats
	TopEmojisUsed     []EmojiBreakdown
	TopEmojisReceived []EmojiBreakdown
	ActivityByHour    []int
	CurrentStreak     *StreakInfo
	LongestStreak     *StreakInfo
}

// UserDetailStats holds user stat numbers
type UserDetailStats struct {
	MessageCount      int
	ReactionsGiven    int
	ReactionsReceived int
	MediaSent         int
	RepliesSent       int
	RepliesReceived   int
	AvgMessageLength  float64
	FirstActive       time.Time
	LastActive        time.Time
}

// StreakInfo holds streak information
type StreakInfo struct {
	Days      int
	StartDate time.Time
	EndDate   time.Time
}

// UserComparison holds comparison between users
type UserComparison struct {
	UserID            int64
	Username          string
	FirstName         string
	LastName          string
	MessageCount      int
	ReactionsGiven    int
	ReactionsReceived int
	MediaSent         int
	AvgMessageLength  float64
}

// FilterParams holds filter parameters for stats
type FilterParams struct {
	Year           int
	AvailableYears []int
	StartDate      time.Time
	EndDate        time.Time
}

templ ChatDetailPage(chat ChatDetail, overview *Overview, leaderboard []LeaderboardEntry, heatmap []HeatmapDay, filter FilterParams, theme string) {
	@Layout(theme, chatDetailTitle(chat), chatDetailContent(chat, overview, leaderboard, heatmap, filter))
}

templ chatDetailContent(chat ChatDetail, overview *Overview, leaderboard []LeaderboardEntry, heatmap []HeatmapDay, filter FilterParams) {
	<div class="space-y-6">
		<!-- Header -->
		<div class="flex items-center gap-4">
			<a href="/" class="btn btn-ghost btn-circle">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
					<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
				</svg>
			</a>
			<div class="flex-1">
				<h1 class="text-3xl font-bold font-heading flex items-center gap-2">
					{ chatIcon(chat.Type) }
					{ chatDetailTitle(chat) }
				</h1>
				if chat.Username != "" {
					<p class="text-base-content/60 font-mono">{ "@" + chat.Username }</p>
				}
			</div>
			<div class="badge badge-primary badge-lg">{ chat.Type }</div>
		</div>

		<!-- Year Filter -->
		<div class="flex items-center gap-4">
			<span class="text-sm text-base-content/60">Showing data for:</span>
			<select
				id="year-select"
				name="year"
				class="select select-bordered select-sm font-mono"
				onchange={ templ.ComponentScript{Call: fmt.Sprintf("window.location.href='/chats/%d?year=' + this.value", chat.ID)} }
			>
				@yearOptions(filter.AvailableYears, filter.Year)
			</select>
			<span class="text-sm text-base-content/60">
				({ formatDateRange(filter.StartDate, filter.EndDate) })
			</span>
		</div>

		<!-- Overview Stats -->
		if overview != nil {
			@overviewSection(overview)
		}

		<!-- Two Column Layout -->
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
			<!-- Leaderboard -->
			<div class="card glass-card">
				<div class="card-body">
					<div class="flex items-center gap-4 mb-4">
						<h2 class="card-title font-heading">Leaderboard</h2>
						<div class="flex-1"></div>
						<div class="tabs tabs-boxed tabs-sm">
							<button
								class="tab tab-active"
								data-metric="messages"
								hx-get={ fmt.Sprintf("/chats/%d/leaderboard?metric=messages&year=%d", chat.ID, filter.Year) }
								hx-target="#leaderboard-content"
								hx-swap="innerHTML"
							>Messages</button>
							<button
								class="tab"
								data-metric="reactions_given"
								hx-get={ fmt.Sprintf("/chats/%d/leaderboard?metric=reactions_given&year=%d", chat.ID, filter.Year) }
								hx-target="#leaderboard-content"
								hx-swap="innerHTML"
							>Given</button>
							<button
								class="tab"
								data-metric="reactions_received"
								hx-get={ fmt.Sprintf("/chats/%d/leaderboard?metric=reactions_received&year=%d", chat.ID, filter.Year) }
								hx-target="#leaderboard-content"
								hx-swap="innerHTML"
							>Received</button>
							<button
								class="tab"
								data-metric="media"
								hx-get={ fmt.Sprintf("/chats/%d/leaderboard?metric=media_sent&year=%d", chat.ID, filter.Year) }
								hx-target="#leaderboard-content"
								hx-swap="innerHTML"
							>Media</button>
						</div>
					</div>
					<div id="leaderboard-content">
						@LeaderboardTable(leaderboard, chat.ID, filter.Year)
					</div>
				</div>
			</div>

			<!-- Activity Heatmap -->
			<div class="card glass-card">
				<div class="card-body">
					<h2 class="card-title font-heading mb-4">Activity Heatmap</h2>
					<div id="heatmap-content">
						@HeatmapChart(heatmap, filter.Year)
					</div>
				</div>
			</div>
		</div>

		<!-- Timeline -->
		<div class="card glass-card">
			<div class="card-body">
				<div class="flex items-center gap-4 mb-4">
					<h2 class="card-title font-heading">Activity Timeline</h2>
					<div class="flex-1"></div>
					<select
						id="timeline-granularity"
						class="select select-bordered select-sm font-mono"
						hx-get={ fmt.Sprintf("/chats/%d/timeline?year=%d", chat.ID, filter.Year) }
						hx-target="#timeline-content"
						hx-swap="innerHTML"
						hx-include="this"
						name="granularity"
					>
						<option value="day">Daily</option>
						<option value="week" selected>Weekly</option>
						<option value="month">Monthly</option>
					</select>
				</div>
				<div id="timeline-content">
					<div id="timeline-chart" class="w-full h-64" data-chat-id={ fmt.Sprintf("%d", chat.ID) } data-year={ fmt.Sprintf("%d", filter.Year) }></div>
				</div>
			</div>
		</div>

		<!-- Top Content -->
		<div class="card glass-card">
			<div class="card-body">
				<div class="flex items-center gap-4 mb-4">
					<h2 class="card-title font-heading">Top Content</h2>
					<div class="flex-1"></div>
					<div class="tabs tabs-boxed tabs-sm">
						<button
							class="tab tab-active"
							hx-get={ fmt.Sprintf("/chats/%d/top-content?metric=most_reacted&year=%d", chat.ID, filter.Year) }
							hx-target="#top-content-list"
							hx-swap="innerHTML"
						>Most Reacted</button>
						<button
							class="tab"
							hx-get={ fmt.Sprintf("/chats/%d/top-content?metric=most_replied&year=%d", chat.ID, filter.Year) }
							hx-target="#top-content-list"
							hx-swap="innerHTML"
						>Most Replied</button>
					</div>
				</div>
				<div id="top-content-list">
					<div class="text-center py-8 text-base-content/60">
						<span class="loading loading-spinner loading-lg"></span>
						<p class="mt-2">Loading top content...</p>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- User Detail Modal -->
	<dialog id="user-detail-modal" class="modal">
		<div class="modal-box max-w-3xl">
			<div id="user-detail-content">
				<!-- Content loaded via HTMX -->
			</div>
			<div class="modal-action">
				<form method="dialog">
					<button class="btn">Close</button>
				</form>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>close</button>
		</form>
	</dialog>

	<script>
		// Tab switching
		document.querySelectorAll('.tabs button').forEach(tab => {
			tab.addEventListener('htmx:afterRequest', function() {
				this.closest('.tabs').querySelectorAll('.tab').forEach(t => t.classList.remove('tab-active'));
				this.classList.add('tab-active');
			});
		});

		// Load initial top content
		htmx.ajax('GET', '/chats/' + document.querySelector('[data-chat-id]').dataset.chatId + '/top-content?metric=most_reacted&year=' + document.querySelector('[data-year]').dataset.year, '#top-content-list');
	</script>
}

templ overviewSection(overview *Overview) {
	<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
		@summaryStatCard("Messages", fmt.Sprintf("%d", overview.TotalMessages), "chat")
		@summaryStatCard("Users", fmt.Sprintf("%d", overview.UniqueUsers), "users")
		@summaryStatCard("Reactions", fmt.Sprintf("%d", overview.TotalReactions), "heart")
		@summaryStatCard("Media", fmt.Sprintf("%d", overview.TotalMedia), "image")
		@summaryStatCard("Msg/Day", fmt.Sprintf("%.1f", overview.MessagesPerDay), "trending-up")
		if overview.MostActiveUser != nil {
			@summaryStatCard("Top User", userDisplayNameFromSummary(overview.MostActiveUser), "crown")
		} else {
			@summaryStatCard("Top User", "-", "crown")
		}
	</div>

	<!-- Top Emojis -->
	if len(overview.TopEmojis) > 0 {
		<div class="card glass-card">
			<div class="card-body py-4">
				<div class="flex items-center gap-4 flex-wrap">
					<span class="text-sm text-base-content/60">Top Reactions:</span>
					for _, emoji := range overview.TopEmojis {
						<div class="badge badge-lg gap-1">
							<span>{ emoji.Emoji }</span>
							<span class="font-mono text-xs">{ fmt.Sprintf("%d", emoji.Count) }</span>
						</div>
					}
				</div>
			</div>
		</div>
	}
}

templ summaryStatCard(label string, value string, iconType string) {
	<div class="stat-card glass-card p-4">
		<div class="flex items-center gap-3">
			<div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center">
				@statIcon(iconType)
			</div>
			<div>
				<div class="text-xl font-bold font-mono">{ value }</div>
				<div class="text-xs text-base-content/60">{ label }</div>
			</div>
		</div>
	</div>
}

templ statIcon(iconType string) {
	switch iconType {
	case "chat":
		<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-primary">
			<path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z"/>
		</svg>
	case "users":
		<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-primary">
			<path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/>
		</svg>
	case "heart":
		<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-primary">
			<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
		</svg>
	case "image":
		<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-primary">
			<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/>
		</svg>
	case "trending-up":
		<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-primary">
			<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941"/>
		</svg>
	case "crown":
		<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-primary">
			<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 002.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 012.916.52 6.003 6.003 0 01-5.395 4.972m0 0a6.726 6.726 0 01-2.749 1.35m0 0a6.772 6.772 0 01-3.044 0"/>
		</svg>
	}
}

templ LeaderboardTable(entries []LeaderboardEntry, chatID int64, year int) {
	if len(entries) == 0 {
		<div class="text-center py-8 text-base-content/60">
			<span class="text-3xl block mb-2">🏆</span>
			No data for selected period
		</div>
	} else {
		<div class="overflow-x-auto">
			<table class="table table-sm">
				<thead>
					<tr>
						<th class="w-12">#</th>
						<th>User</th>
						<th class="text-right font-mono">Score</th>
					</tr>
				</thead>
				<tbody>
					for _, entry := range entries {
						<tr
							class="hover cursor-pointer"
							hx-get={ fmt.Sprintf("/chats/%d/users/%d?year=%d", chatID, entry.UserID, year) }
							hx-target="#user-detail-content"
							hx-swap="innerHTML"
							onclick="document.getElementById('user-detail-modal').showModal()"
						>
							<td>
								@rankBadge(entry.Rank)
							</td>
							<td>
								<div class="flex items-center gap-2">
									<div class="avatar placeholder">
										<div class="bg-neutral text-neutral-content rounded-full w-8">
											<span class="text-xs">{ userInitials(entry.FirstName, entry.LastName, entry.Username) }</span>
										</div>
									</div>
									<div>
										<div class="font-medium">{ userDisplayNameFromEntry(entry) }</div>
										if entry.Username != "" {
											<div class="text-xs text-base-content/60 font-mono">{ "@" + entry.Username }</div>
										}
									</div>
								</div>
							</td>
							<td class="text-right font-mono font-bold">{ fmt.Sprintf("%d", entry.Score) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ rankBadge(rank int) {
	switch rank {
	case 1:
		<span class="text-lg">🥇</span>
	case 2:
		<span class="text-lg">🥈</span>
	case 3:
		<span class="text-lg">🥉</span>
	default:
		<span class="text-base-content/60 font-mono">{ fmt.Sprintf("%d", rank) }</span>
	}
}

templ HeatmapChart(days []HeatmapDay, year int) {
	<div
		id="activity-calendar"
		class="w-full h-48"
		data-calendar-data={ calendarDataJSON(days) }
		data-year={ fmt.Sprintf("%d", year) }
	></div>
	<script>
		if (typeof initCalendar === 'function') {
			initCalendar();
		}
	</script>
}

templ TimelineChart(points []TimelinePoint, granularity string) {
	<div
		id="timeline-chart"
		class="w-full h-64"
		data-timeline-data={ timelineDataJSON(points) }
		data-granularity={ granularity }
	></div>
	<script>
		if (typeof initTimeline === 'function') {
			initTimeline();
		}
	</script>
}

templ TopContentList(messages []TopMessage, metric string) {
	if len(messages) == 0 {
		<div class="text-center py-8 text-base-content/60">
			<span class="text-3xl block mb-2">📝</span>
			No content for selected period
		</div>
	} else {
		<div class="space-y-4">
			for _, msg := range messages {
				<div class="card bg-base-200">
					<div class="card-body p-4">
						<div class="flex items-start gap-3">
							<div class="avatar placeholder">
								<div class="bg-neutral text-neutral-content rounded-full w-10">
									<span class="text-sm">{ userInitials(msg.FirstName, msg.LastName, msg.Username) }</span>
								</div>
							</div>
							<div class="flex-1 min-w-0">
								<div class="flex items-center gap-2 mb-1">
									<span class="font-medium">{ userDisplayNameFromMsg(msg) }</span>
									<span class="text-xs text-base-content/60">{ formatDateTime(msg.SentAt) }</span>
								</div>
								<p class="text-sm break-words">{ truncateText(msg.Text, 200) }</p>
								if len(msg.TopReactions) > 0 {
									<div class="flex items-center gap-2 mt-2">
										for _, r := range msg.TopReactions {
											<span class="badge badge-sm gap-1">
												{ r.Emoji }
												<span class="font-mono">{ fmt.Sprintf("%d", r.Count) }</span>
											</span>
										}
									</div>
								}
							</div>
							<div class="badge badge-primary badge-lg font-mono">{ fmt.Sprintf("%d", msg.Score) }</div>
						</div>
					</div>
				</div>
			}
		</div>
	}
}

templ UserDetailContent(user *UserDetail) {
	if user == nil {
		<div class="text-center py-8 text-base-content/60">
			<span class="text-3xl block mb-2">👤</span>
			User not found
		</div>
	} else {
		<!-- User Header -->
		<div class="flex items-center gap-4 mb-6">
			<div class="avatar placeholder">
				<div class="bg-primary text-primary-content rounded-full w-16">
					<span class="text-xl">{ userInitials(user.FirstName, user.LastName, user.Username) }</span>
				</div>
			</div>
			<div>
				<h3 class="text-xl font-bold">{ userDisplayNameFromDetail(user) }</h3>
				if user.Username != "" {
					<p class="text-base-content/60 font-mono">{ "@" + user.Username }</p>
				}
			</div>
		</div>

		<!-- Stats Grid -->
		<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
			<div class="stat bg-base-200 rounded-lg p-3">
				<div class="stat-title text-xs">Messages</div>
				<div class="stat-value text-lg font-mono">{ fmt.Sprintf("%d", user.Stats.MessageCount) }</div>
			</div>
			<div class="stat bg-base-200 rounded-lg p-3">
				<div class="stat-title text-xs">Reactions Given</div>
				<div class="stat-value text-lg font-mono">{ fmt.Sprintf("%d", user.Stats.ReactionsGiven) }</div>
			</div>
			<div class="stat bg-base-200 rounded-lg p-3">
				<div class="stat-title text-xs">Reactions Received</div>
				<div class="stat-value text-lg font-mono">{ fmt.Sprintf("%d", user.Stats.ReactionsReceived) }</div>
			</div>
			<div class="stat bg-base-200 rounded-lg p-3">
				<div class="stat-title text-xs">Media Sent</div>
				<div class="stat-value text-lg font-mono">{ fmt.Sprintf("%d", user.Stats.MediaSent) }</div>
			</div>
		</div>

		<!-- Streaks -->
		if user.CurrentStreak != nil || user.LongestStreak != nil {
			<div class="flex gap-4 mb-6">
				if user.CurrentStreak != nil && user.CurrentStreak.Days > 0 {
					<div class="badge badge-success gap-2 p-3">
						<span>🔥</span>
						<span>{ fmt.Sprintf("%d day streak", user.CurrentStreak.Days) }</span>
					</div>
				}
				if user.LongestStreak != nil && user.LongestStreak.Days > 0 {
					<div class="badge badge-warning gap-2 p-3">
						<span>🏆</span>
						<span>{ fmt.Sprintf("Best: %d days", user.LongestStreak.Days) }</span>
					</div>
				}
			</div>
		}

		<!-- Top Emojis -->
		<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
			if len(user.TopEmojisUsed) > 0 {
				<div>
					<h4 class="text-sm font-semibold mb-2">Most Used Emojis</h4>
					<div class="flex flex-wrap gap-2">
						for _, e := range user.TopEmojisUsed {
							<span class="badge gap-1">{ e.Emoji } { fmt.Sprintf("%d", e.Count) }</span>
						}
					</div>
				</div>
			}
			if len(user.TopEmojisReceived) > 0 {
				<div>
					<h4 class="text-sm font-semibold mb-2">Most Received Emojis</h4>
					<div class="flex flex-wrap gap-2">
						for _, e := range user.TopEmojisReceived {
							<span class="badge gap-1">{ e.Emoji } { fmt.Sprintf("%d", e.Count) }</span>
						}
					</div>
				</div>
			}
		</div>

		<!-- Activity by Hour -->
		if len(user.ActivityByHour) > 0 {
			<div>
				<h4 class="text-sm font-semibold mb-2">Activity by Hour</h4>
				<div id="user-activity-chart" class="w-full h-32" data-activity-data={ activityByHourJSON(user.ActivityByHour) }></div>
			</div>
			<script>
				if (typeof initUserActivityChart === 'function') {
					initUserActivityChart();
				}
			</script>
		}
	}
}

templ CompareUsersTable(comparisons []UserComparison) {
	if len(comparisons) == 0 {
		<div class="text-center py-8 text-base-content/60">
			<span class="text-3xl block mb-2">⚖️</span>
			Select users to compare
		</div>
	} else {
		<div class="overflow-x-auto">
			<table class="table table-sm">
				<thead>
					<tr>
						<th>User</th>
						<th class="text-right font-mono">Messages</th>
						<th class="text-right font-mono">Reactions Given</th>
						<th class="text-right font-mono">Reactions Received</th>
						<th class="text-right font-mono">Media</th>
						<th class="text-right font-mono">Avg Length</th>
					</tr>
				</thead>
				<tbody>
					for _, c := range comparisons {
						<tr class="hover">
							<td>
								<div class="flex items-center gap-2">
									<div class="avatar placeholder">
										<div class="bg-neutral text-neutral-content rounded-full w-8">
											<span class="text-xs">{ userInitials(c.FirstName, c.LastName, c.Username) }</span>
										</div>
									</div>
									<span class="font-medium">{ userDisplayNameFromComparison(c) }</span>
								</div>
							</td>
							<td class="text-right font-mono">{ fmt.Sprintf("%d", c.MessageCount) }</td>
							<td class="text-right font-mono">{ fmt.Sprintf("%d", c.ReactionsGiven) }</td>
							<td class="text-right font-mono">{ fmt.Sprintf("%d", c.ReactionsReceived) }</td>
							<td class="text-right font-mono">{ fmt.Sprintf("%d", c.MediaSent) }</td>
							<td class="text-right font-mono">{ fmt.Sprintf("%.1f", c.AvgMessageLength) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ yearOptions(years []int, selectedYear int) {
	for _, y := range years {
		<option value={ fmt.Sprintf("%d", y) } selected?={ selectedYear == y }>
			{ fmt.Sprintf("%d", y) }
		</option>
	}
}

func chatDetailTitle(chat ChatDetail) string {
	if chat.Title != "" {
		return chat.Title
	}
	name := ""
	if chat.FirstName != "" {
		name = chat.FirstName
	}
	if chat.LastName != "" {
		if name != "" {
			name += " "
		}
		name += chat.LastName
	}
	if name != "" {
		return name
	}
	if chat.Username != "" {
		return "@" + chat.Username
	}
	return fmt.Sprintf("Chat %d", chat.ID)
}

func userInitials(firstName, lastName, username string) string {
	if firstName != "" && lastName != "" {
		return string(firstName[0]) + string(lastName[0])
	}
	if firstName != "" {
		return string(firstName[0])
	}
	if username != "" {
		return string(username[0])
	}
	return "?"
}

func userDisplayNameFromSummary(u *UserSummary) string {
	if u == nil {
		return "-"
	}
	if u.FirstName != "" || u.LastName != "" {
		name := u.FirstName
		if u.LastName != "" {
			if name != "" {
				name += " "
			}
			name += u.LastName
		}
		return name
	}
	if u.Username != "" {
		return "@" + u.Username
	}
	return fmt.Sprintf("User %d", u.UserID)
}


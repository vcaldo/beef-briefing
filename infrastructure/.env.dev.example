# Development Environment Variables
# Copy to .env.dev and fill in values
# Used with: docker-compose -f docker-compose.dev.yml --env-file .env.dev up

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# In development, use Docker service name 'postgres' for container networking
DB_HOST=postgres
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=beef_briefing
DB_PORT=5432
DB_SSL_MODE=disable

# =============================================================================
# API SERVICE CONFIGURATION
# =============================================================================
API_PORT=8080
MAX_UPLOAD_SIZE_MB=100
API_SERVICE_URL=http://api-service:8080

# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_without_at_sign

# =============================================================================
# MINIO CONFIGURATION (Local Development)
# =============================================================================
# In development, use local MinIO container
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=telegram-media
MINIO_USE_SSL=false
MINIO_REGION=
# Bucket suffix for Makefile operations
OBJECT_STORAGE_BUCKET_SUFFIX=telegram-media

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=debug

# =============================================================================
# LEADERBOARD SERVICE CONFIGURATION
# =============================================================================
LEADERBOARD_PORT=8050
LEADERBOARD_PATH=/leaderboard
ADMIN_USER_IDS=1234567890

# =============================================================================
# ML DASHBOARD CONFIGURATION
# =============================================================================
ML_DASHBOARD_PORT=8501

# =============================================================================
# ML PROCESSOR SERVICE CONFIGURATION
# =============================================================================
ML_BATCH_SIZE=500
ML_SLEEP_SECONDS=60
ML_DEVICE=cuda

# Provider selection (local, openai, anthropic, perspective)
# Use "local" for GPU-based processing, "openai" for API-based
SENTIMENT_PROVIDER=local
TOXICITY_PROVIDER=local
EMBEDDINGS_PROVIDER=local
TOPICS_PROVIDER=local
NER_PROVIDER=local
HUMOR_PROVIDER=local
QUESTIONS_PROVIDER=local

# API Keys (required for non-local providers)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# PERSPECTIVE_API_KEY=...

# =============================================================================
# API AUTHENTICATION
# =============================================================================
# App keys are loaded from files in infrastructure/secrets/apps/
# Generate keys with: make secrets-service-api APP=telegram-bot
# Generate keys with: make secrets-service-api APP=leaderboard
# Generate keys with: make secrets-service-api APP=ml-processor
# Keys are mounted as volumes in docker-compose (no env vars needed)

# =============================================================================
# TRAEFIK REVERSE PROXY & SSL CONFIGURATION
# =============================================================================
# Domain name (not used in dev, but kept for consistency)
DOMAIN_NAME=localhost
# Let's Encrypt email (not used in dev, but kept for consistency)
LETSENCRYPT_EMAIL=dev@localhost

# =============================================================================
# LINODE VOLUME STORAGE
# =============================================================================
# Mount path for PostgreSQL data (not used in dev, but kept for consistency)
POSTGRES_DATA_PATH=/mnt/postgres-data

# =============================================================================
# NEW RELIC APM CONFIGURATION (OPTIONAL)
# =============================================================================
# Application Performance Monitoring - leave blank to disable
# App name format: {base-name}-{service}-{environment}
# e.g., NEW_RELIC_APP_NAME=beef-briefing with api-service becomes:
#   "beef-briefing-api-service-development"
# NEW_RELIC_APP_NAME=beef-briefing
# NEW_RELIC_LICENSE_KEY=your_new_relic_license_key_here

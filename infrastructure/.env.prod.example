# Production Environment Variables
# Copy to .env.prod and fill in values
# Used with: docker-compose -f docker-compose.prod.yml --env-file .env.prod up

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# In production, use Docker service name 'postgres' for container networking
DB_HOST=postgres
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=beef_briefing
DB_PORT=5432
DB_SSL_MODE=disable

# =============================================================================
# API SERVICE CONFIGURATION
# =============================================================================
API_PORT=8080
MAX_UPLOAD_SIZE_MB=100
API_SERVICE_URL=http://api-service:8080

# =============================================================================
# LEADERBOARD SERVICE CONFIGURATION
# =============================================================================
LEADERBOARD_PORT=8050
LEADERBOARD_PATH=/leaderboard
ADMIN_USER_IDS=1234567890

# =============================================================================
# ML PROCESSOR SERVICE CONFIGURATION (runs locally with GPU)
# =============================================================================
ML_BATCH_SIZE=500
ML_SLEEP_SECONDS=60
ML_DEVICE=cuda

# Provider selection (local, openai, anthropic, perspective)
# Use "local" for GPU-based processing, "openai" for API-based
SENTIMENT_PROVIDER=local
TOXICITY_PROVIDER=local
EMBEDDINGS_PROVIDER=local
TOPICS_PROVIDER=local
NER_PROVIDER=local
HUMOR_PROVIDER=local
QUESTIONS_PROVIDER=local

# API Keys (required for non-local providers)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# PERSPECTIVE_API_KEY=...

# OpenAI Rate Limiting (Tier 1 defaults - adjust for higher tiers)
OPENAI_RATE_LIMIT_ENABLED=true
OPENAI_RATE_LIMIT_TIMEOUT=120.0
# gpt-4o-mini limits (shared by sentiment, humor, questions, NER)
OPENAI_GPT4O_MINI_TPM=200000
OPENAI_GPT4O_MINI_RPM=500
# text-embedding-3-small limits (embeddings, topics)
OPENAI_EMBEDDING_TPM=1000000
OPENAI_EMBEDDING_RPM=3000
# omni-moderation-latest limits (toxicity)
OPENAI_MODERATION_TPM=10000
OPENAI_MODERATION_RPM=500

# =============================================================================
# TIER CONFIGURATION
# =============================================================================
# Format: NAME:MIN_SCORE (ordered from highest to lowest tier)
# Users are assigned to the first tier where their score >= MIN_SCORE
TIER_1=Lendário:81
TIER_2=Bichão:77
TIER_3=CLT:72
TIER_4=Coadjuvante:55
TIER_5=Fióti:32
TIER_6=Random:10

# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================
TELEGRAM_BOT_TOKEN=your_production_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_without_at_sign

# =============================================================================
# LINODE OBJECT STORAGE CONFIGURATION
# =============================================================================
# Credentials from Terraform output (linode_object_storage_key)
# Use 'make tf-sync-object-storage-env' to sync values from Terraform after 'make tf-apply'
# The app uses MINIO_* env vars for S3-compatible storage
MINIO_ENDPOINT=es-mad-1.linodeobjects.com
MINIO_ACCESS_KEY=your_linode_access_key
MINIO_SECRET_KEY=your_linode_secret_key
MINIO_BUCKET=your-domain-bucket-name
MINIO_USE_SSL=true
MINIO_REGION=es-mad-1

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=production
LOG_LEVEL=info

# =============================================================================
# CARD IMAGE GENERATOR SERVICE CONFIGURATION
# =============================================================================
# Internal URL for services running in Docker (leaderboard -> card-image-generator)
CARD_RENDERER_URL=http://card-image-generator:8051
# Default theme for card generation (gaming, meme, clean, sticker, vaporwave, etc.)
DEFAULT_CARD_THEME=neon_arcade
# External URL for ml-processor running locally: https://cards-api.${DOMAIN_NAME}
# (automatically set by scripts/ml-processor.sh --prod)

# API key for ml-processor to authenticate to card-image-generator
# Set after running: make secrets-card-image-generator APP=ml-processor
CARD_RENDERER_API_KEY=

# =============================================================================
# DECK MINI APP CONFIGURATION
# =============================================================================
# JWT secret for Mini App authentication (generate with: openssl rand -hex 32)
# Required for Telegram Mini App authentication to work
JWT_SECRET_KEY=

# =============================================================================
# API AUTHENTICATION
# =============================================================================
# App keys are loaded from files in infrastructure/secrets/apps/
# Generate keys with: make secrets-service-api APP=telegram-bot
# Generate keys with: make secrets-service-api APP=leaderboard
# Generate keys with: make secrets-service-api APP=ml-processor
# Generate keys with: make secrets-service-api APP=card-image-generator
# Keys are mounted as volumes in docker-compose (no env vars needed)

# =============================================================================
# TRAEFIK REVERSE PROXY & SSL CONFIGURATION
# =============================================================================
# Domain name for SSL certificates and routing
# Note: DOMAIN_NAME is also used by Terraform (see LINODE/TERRAFORM section below)
# Make sure both references use the same domain value
DOMAIN_NAME=mydomain.example

# Let's Encrypt email for certificate notifications and renewal alerts
# IMPORTANT: This email will receive certificate expiry warnings
LETSENCRYPT_EMAIL=admin@mydomain.example

# IP allowlist for external API access (api.${DOMAIN_NAME} and cards-api.${DOMAIN_NAME})
# Auto-populated by deploy.sh from whatismyip.akamai.com
ALLOWED_IP=

# =============================================================================
# LINODE VOLUME STORAGE
# =============================================================================
# Mount path for PostgreSQL data (must match terraform postgres_volume_mount_path)
POSTGRES_DATA_PATH=/mnt/postgres-data

# =============================================================================
# =============================================================================
#                    PRODUCTION-ONLY SECTIONS BELOW
# =============================================================================
# =============================================================================

# =============================================================================
# TRAEFIK DASHBOARD AUTHENTICATION (PRODUCTION ONLY)
# =============================================================================
# Traefik dashboard basic auth credentials (htpasswd format with bcrypt)
# Generate with: make generate-traefik-password ENV_FILE=infrastructure/.env.prod
# Format: username:$$2y$$05$$hashedpassword
# Note: $$ escapes the $ character for docker-compose (required)
# Example output: admin:$$2y$$05$$gHL5l9SFHfFGrJm4gVQ65OrLFsMfSrZK7GwDPFJRE5gJQTDRvdlT2
TRAEFIK_DASHBOARD_USERS=admin:$$2y$$05$$...your_bcrypt_hash_here...

# =============================================================================
# DOCKER IMAGE TAG (PRODUCTION ONLY)
# =============================================================================
# Set by CI/CD or Makefile during deployment (git commit hash)
IMAGE_TAG=latest

# =============================================================================
# LINODE / TERRAFORM CONFIGURATION (PRODUCTION ONLY)
# =============================================================================
# These are used by Terraform, not by the application directly

# Linode API token for Terraform
LINODE_TOKEN=your_linode_api_token_here

# Linode region for deployment (default: eu-central)
# Available regions: eu-central, es-mad, us-east, us-central, us-southeast, etc.
LINODE_REGION=eu-central

# Linode instance type (default: g6-standard-1)
# Available types: g6-nanode-1, g6-standard-1, g6-standard-2, g6-standard-4, etc.
LINODE_INSTANCE_TYPE=g6-standard-1

# Hostname for the Linode instance (default: beef-briefing)
LINODE_HOSTNAME=beef-briefing

# SSH Public Key for server access
SSH_PUBLIC_KEY_PATH=~/.ssh/id_rsa.pub

# Linode Block Storage size in GB (default: 10)
POSTGRES_VOLUME_SIZE=10

# Bucket suffix for Terraform (final name: {domain}-{suffix})
# Used by 'make tf-setup' to populate terraform.tfvars
OBJECT_STORAGE_BUCKET_SUFFIX=beef-briefing-media

# Linode Object Storage region (default: es-mad)
OBJECT_STORAGE_REGION=es-mad

# Enable versioning for Object Storage bucket (default: true)
OBJECT_STORAGE_VERSIONING=true

# Object Storage lifecycle: days until objects expire (default: 365)
OBJECT_STORAGE_LIFECYCLE_DAYS=365

# Object Storage lifecycle: days until old versions expire (default: 5)
OBJECT_STORAGE_VERSION_RETENTION_DAYS=5

# =============================================================================
# NEW RELIC MONITORING (PRODUCTION ONLY)
# =============================================================================
# Infrastructure monitoring (used by Terraform)
NEW_RELIC_API_KEY=your_new_relic_api_key_here
NEW_RELIC_ACCOUNT_ID=your_new_relic_account_id_here
NEW_RELIC_REGION=EU

# APM instrumentation (leave blank to disable)
# App name format: {base-name}-{service}-{environment}
# e.g., NEW_RELIC_APP_NAME=beef-briefing with api-service becomes:
#   "beef-briefing-api-service-production"
NEW_RELIC_APP_NAME=beef-briefing
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key_here

# =============================================================================
# NEW RELIC BROWSER MONITORING (deck-mini-app)
# =============================================================================
# Browser-side Real User Monitoring (RUM) for the Telegram Mini App
# Get these values from: New Relic > Browser > Add app > Select Pro + SPA
# Note: These are different from APM license keys
# Note: NEW_RELIC_ACCOUNT_ID is shared with Infrastructure/APM above

# Browser application ID (from New Relic Browser setup)
NEW_RELIC_BROWSER_APP_ID=your_browser_app_id

# Browser license key (ingest key, NOT the APM license key)
# This is a public key that will be embedded in the JavaScript bundle
NEW_RELIC_BROWSER_LICENSE_KEY=your_browser_license_key

# Common environment variables template
# Copy to .env or .env.dev and fill in values

# Database Configuration
DB_HOST=postgres
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=beef_briefing
DB_PORT=5432
DB_SSL_MODE=disable

# API Service Configuration
API_PORT=8080

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=telegram-media
MINIO_USE_SSL=false

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=debug

# Admin Panel Secrets (file-based - recommended)
# The admin panel will read these from mounted secret files
# Generate secrets with: make admin-panel-set-secrets-files
ADMIN_PASSWORD_HASH_FILE=/app/secrets/admin_password_hash
SESSION_SECRET_FILE=/app/secrets/session_secret

# Legacy env-based secrets (deprecated - use files instead)
# ADMIN_PASSWORD_HASH=
# SESSION_SECRET=

# Production Only Settings

# Linode Token for Terraform (if deploying to Linode)
LINODE_TOKEN=your_linode_api_token_here
# Domain Configuration
DOMAIN_NAME=mydomain.example

# New Relic Configuration (optional)
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key_here

# SSH Public Key for server access (used in Terraform)
SSH_PUBLIC_KEY_PATH=~/.ssh/id_rsa.pub

# .gitignore for beef-breefing monorepo

# Environment files
.env
.env.local
.env.*.local
.env.cloud
.env.llm
.env.dev
infrastructure/.env.dev
infrastructure/.env.prod
infrastructure/.env.llm

# Go
*.o
*.a
*.so
.DS_Store
vendor/
go.sum.new
*.mod.new

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
env/
.venv
.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*.swn
*.sublime-*
.vim/
*.iml

# OS
.DS_Store
Thumbs.db
*.log

# Docker
.dockerignore
docker-compose.override.yml

# Databases
*.sql.bak
pgdata/
postgres_data/
postgres_data_dev/

# Ollama
ollama_models/
ollama_models_dev/
ollama_cache/

# Build artifacts
*.o
*.a
dist/
build/
bin/
target/

# Node (if added in future)
node_modules/
npm-debug.log
yarn-error.log

# Temporary files
*.tmp
*.bak
*.backup
*.temp

# Git
.git/
.gitkeep

# CI/CD
.github/workflows/*.log

# Secrets
.env.dev
.env.prod
secrets.json
credentials/
private_keys/
infrastructure/secrets/*
!infrastructure/secrets/README.md

# Let's Encrypt certificates (SSL)
infrastructure/letsencrypt/
letsencrypt/
acme.json
acme-staging.json

# Test coverage
coverage/
*.out
coverage.html

# Local development overrides
docker-compose.override.yml
.env.local.*

# Local docs
local_docs/

# Local import
local_import/
import-report.md
.import-state.json

# Local backups (keep docs, ignore backup files)
local_backups/pgsql/*.sql.gz
local_backups/pgsql/*.sql
local_backups/pgsql/restore.sql
local_backups/db/*.sql.gz
local_backups/db/*.sql

# Ignore all backup files
*.sql
*.sql.gz
*.dump


# Terraform
*.tfstate
*.tfstate.*
*.tfvars
.terraform/
.terraform.lock.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Claude
.claude/settings.local.json
.claude/settings.local.json
apps/dashboard/ux-improvements.md
